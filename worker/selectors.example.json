{
  "verified": false,
  "authenticated": "a[href*='logout'], img[alt='로그아웃']",
  "listReady": "table:has(th:has-text('모집마감일'))",
  "emptyList": "td:has-text('조회된 데이터가 없습니다')",
  "listHeader": "table:has(th:has-text('모집마감일')) tr:first-child > *",
