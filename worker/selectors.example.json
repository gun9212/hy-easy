  "listCell": "td",
  "detailLink": "td:nth-child(4) a",
  "sourceIdAttribute": "onclick",
  "sourceIdPattern": "\\(\\s*'?([\\w.-]+)'?",
  "detailUrlTemplate": "https://hywep.hanyang.ac.kr/compjoinmanage/view_stu.do?REPLACE_WITH_VERIFIED_PARAM={id}",
  "nextPage": "a.next",
  "nextDisabled": "[aria-disabled='true'], .disabled",
  "detailReady": "h3:has-text('실습기관 정보'), :text('실습기관 정보')",
  "detailRows": "table tr",
  "label": "th",
  "value": "td"
