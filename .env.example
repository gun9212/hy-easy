# The web app never falls back to sample data for authenticated routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public, fictional /demo is available in development; opt in explicitly in production.
DEMO_ENABLED=false
# Worker only. Never NEXT_PUBLIC_ prefix these values.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_PROJECT=
MODEL_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_LOCATION=global
# Models must pass evaluation before automatic labels are published.
AI_CLASSIFICATION_ENABLED=false
HYWEP_LIST_URL=
HYWEP_SELECTORS_FILE=worker/selectors.example.json
HYWEP_STORAGE_STATE=.secrets/hywep-state.json
# Cloud deployment uses this private GCS object instead of a local session.
HYWEP_SESSION_BUCKET=
HYWEP_SESSION_OBJECT=hywep-state.json
